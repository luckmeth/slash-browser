<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  The release manifest sets usesCleartextTraffic="false" and that must stay
  true — a browser that will speak plain HTTP to its own sync server is a
  browser whose encrypted-sync promise can be stripped in transit.

  This file lives in src/debug/, so it is merged into debug builds and cannot
  reach a release APK. It permits cleartext to exactly two names: the emulator's
  alias for the host machine, and loopback. Nothing else, and no wildcard.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
